#!/bin/bash
# Generated by terraform-aws-ec2-module: writes /etc/pbs/app.env from plain variables and secrets.
# Runs in a subshell so its strict mode does not leak into the user's own script below.
(
  set -euo pipefail
  umask 077
  install -d -m 0750 /etc/pbs
  env_file=/etc/pbs/app.env
  : > "$env_file"
%{ for k, v in environment_variables ~}
  printf '%s=%s\n' '${k}' '${replace(v, "'", "'\\''")}' >> "$env_file"
%{ endfor ~}
%{ for k, v in ssm_secrets ~}
  printf '%s=%s\n' '${k}' "$(aws ssm get-parameter --region ${region} --with-decryption --name '${v}' --query Parameter.Value --output text)" >> "$env_file"
%{ endfor ~}
%{ for k, v in secrets_manager_secrets ~}
  printf '%s=%s\n' '${k}' "$(aws secretsmanager get-secret-value --region ${region} --secret-id '${v}' --query SecretString --output text)" >> "$env_file"
%{ endfor ~}
  chmod 0600 "$env_file"
) || { echo "terraform-aws-ec2-module: failed to write /etc/pbs/app.env" >&2; exit 1; }
